{
  "name": "wnba-oracle-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node build-serve-config.mjs serve.template.json serve.json && serve -c serve.json -s dist -l ${PORT:-4173}",
    "preview": "vite preview --port 4173 --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test-e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
