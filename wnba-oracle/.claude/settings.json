{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/hanslarson/Desktop/mlb-oracle"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(railway down:*)",
      "Bash(railway delete:*)",
      "Edit(/Users/hanslarson/Desktop/mlb-oracle/**)",
      "Write(/Users/hanslarson/Desktop/mlb-oracle/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/credentials.md)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "env": {
    "ANTHROPIC_MODEL": "claude-opus-4-7",
    "API_TIMEOUT_MS": "1200000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ./scripts/verify-creds.sh ] && bash ./scripts/verify-creds.sh || true"
          }
        ]
      }
    ]
  }
}
