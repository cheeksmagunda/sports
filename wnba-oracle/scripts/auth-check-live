#!/usr/bin/env python3
"""Validate configured WNBA auth capabilities without printing values."""

from __future__ import annotations

import base64
import gzip
import importlib.util
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any
from urllib import error, parse, request

TIMEOUT_SECONDS = 10
RAILWAY_ENDPOINT = "https://backboard.railway.com/graphql/v2"
# Smallest query each token kind is allowed to answer: a project token cannot
# list projects, and an account/workspace token has no projectToken.
RAILWAY_PROBE_QUERY = {
    "Authorization": "query { projects { edges { node { id } } } }",
    "Project-Access-Token": "query { projectToken { projectId environmentId } }",
}


def report(name: str, result: str) -> None:
    print(f"{name}: {result}")


def check_github() -> int:
    gh = shutil.which("gh")
    if gh is None:
        report("github", "not checked, gh is unavailable")
        return 0
    try:
        result = subprocess.run(
            [gh, "auth", "status", "--hostname", "github.com"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        report("github", "validation timed out")
        return 1
    if result.returncode == 0:
        report("github", "authenticated")
        return 0
    report("github", "authentication failed")
    return 1


def check_railway_cli() -> int:
    railway = shutil.which("railway")
    if railway is None:
        report("railway CLI", "not checked, CLI is unavailable")
        return 0
    try:
        result = subprocess.run(
            [railway, "whoami"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        report("railway CLI", "validation timed out")
        return 1
    if result.returncode == 0:
        report("railway CLI", "authenticated")
    else:
        report("railway CLI", "not authenticated")
    return int(result.returncode != 0)


def load_rwgql() -> Any:
    """Import the sibling rwgql.py so header choice and User-Agent stay single-sourced."""
    module_path = Path(__file__).resolve().parent / "rwgql.py"
    spec = importlib.util.spec_from_file_location("wnba_rwgql", module_path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {module_path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def railway_probe(environ: dict[str, str]) -> request.Request | None:
    """Build the value-free Railway probe for whichever token kind is set.

    Returns None when neither or both of RAILWAY_API_TOKEN and RAILWAY_TOKEN
    are present; rwgql.resolve_auth refuses the ambiguous case for the same
    reason (a mismatched header fails with an opaque 401).
    """
    rwgql = load_rwgql()
    auth = rwgql.resolve_auth(environ)
    if auth is None:
        return None
    header = next(iter(auth))
    payload = json.dumps({"query": RAILWAY_PROBE_QUERY[header]}).encode()
    return request.Request(
        RAILWAY_ENDPOINT,
        data=payload,
        method="POST",
        headers=rwgql.build_headers(auth),
    )


def check_railway_graphql() -> int:
    configured = [
        name
        for name in ("RAILWAY_API_TOKEN", "RAILWAY_TOKEN")
        if os.environ.get(name, "").strip()
    ]
    if not configured:
        report("railway GraphQL", "not configured")
        return 0
    req = railway_probe(dict(os.environ))
    if req is None:
        report(
            "railway GraphQL",
            "ambiguous, set exactly one of RAILWAY_API_TOKEN or RAILWAY_TOKEN",
        )
        return 1
    try:
        with request.urlopen(req, timeout=TIMEOUT_SECONDS) as response:
            body = response.read()
        decoded = json.loads(body)
    except (error.URLError, TimeoutError, json.JSONDecodeError):
        report("railway GraphQL", "validation failed")
        return 1
    if isinstance(decoded, dict) and decoded.get("data") and not decoded.get("errors"):
        report("railway GraphQL", f"authenticated ({configured[0]})")
        return 0
    report("railway GraphQL", "authentication failed")
    return 1


def check_odds_api() -> int:
    key = os.environ.get("ODDS_API_KEY", "").strip()
    if not key:
        report("odds provider", "not configured")
        return 0
    query = parse.urlencode({"apiKey": key})
    req = request.Request(f"https://api.the-odds-api.com/v4/sports?{query}")
    try:
        with request.urlopen(req, timeout=TIMEOUT_SECONDS) as response:
            response.read(1)
            code = response.status
    except error.HTTPError as exc:
        code = exc.code
    except (error.URLError, TimeoutError):
        report("odds provider", "validation failed")
        return 1
    if code == 200:
        report("odds provider", "authenticated")
        return 0
    report("odds provider", f"validation failed with HTTP {code}")
    return 1


def check_real_sports() -> int:
    encoded = os.environ.get("REALSPORTS_STORAGE_STATE_B64GZ", "").strip()
    if not encoded:
        report("Real Sports derived session", "not configured, browser recovery only")
        return 0
    try:
        raw = gzip.decompress(base64.b64decode(encoded, validate=True))
        payload = json.loads(raw)
    except (ValueError, OSError, json.JSONDecodeError):
        report("Real Sports derived session", "invalid payload")
        return 1
    if isinstance(payload, dict) and isinstance(payload.get("origins"), list):
        report("Real Sports derived session", "payload structure valid")
        return 0
    report("Real Sports derived session", "invalid storage-state structure")
    return 1


def main() -> int:
    errors = 0
    errors += check_github()
    errors += check_railway_cli()
    errors += check_railway_graphql()
    errors += check_odds_api()
    errors += check_real_sports()
    if errors:
        print(f"auth-check: live checks failed with {errors} issue(s)", file=sys.stderr)
        return 1
    print("auth-check: live checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
