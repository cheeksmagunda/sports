# WNBA Oracle environment variables.
# Copy to .env and fill in. .env is gitignored.
#
# All five of these are required for the runtime to function.
# DATABASE_URL and REDIS_URL are added after `railway up` provisions the services.

# GitHub: fine-grained personal access token with repo scope on the wnba-oracle repo.
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Railway: account token from https://railway.app/account/tokens (NOT a project token).
RAILWAY_TOKEN=

# The Odds API: https://the-odds-api.com/ -> dashboard -> API key.
ODDS_API_KEY=

# Real Sports login (used by the headless re-auth in Job 1; see handoff Part 0.6).
# JWT is never stored; it is minted fresh from these each run.
REAL_SPORTS_USERNAME=
REAL_SPORTS_PASSWORD=

# Filled in after Railway provisions Postgres and Redis.
DATABASE_URL=
REDIS_URL=
