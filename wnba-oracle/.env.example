# WNBA Oracle environment contract. Every tracked value is intentionally empty.
# Runtime values come from the process environment or deployment platform.
# Optional SOPS files provide local at-rest storage only.

# Provider credentials and derived sessions. Required only by roles that use
# the corresponding provider.
# auth:optional
ODDS_API_KEY=
# Legacy names retained for compatibility. Scripted login is not a supported
# recovery path; operators recover a session in an ordinary browser.
REAL_SPORTS_USERNAME=
REAL_SPORTS_PASSWORD=
REALSPORTS_STORAGE_STATE_B64GZ=
# Account-wide Real Sports collection guardrails. These coordinate whole
# provider-touching job windows across sports; they are reliability limits,
# not provider rate-limit claims. Code defaults: 180 minutes, 4 windows per
# America/Los_Angeles day, shared scope "realsports-paid-account".
REALSPORTS_ACCESS_SCOPE=
REALSPORTS_MIN_ACCESS_INTERVAL_MINUTES=
REALSPORTS_MAX_ACCESS_WINDOWS_PER_DAY=
REALSPORTS_ACCESS_TIMEZONE=
# Use only for an intentionally scoped project-token workflow. Normal Railway
# CLI commands use the native Railway login and do not duplicate its token.
RAILWAY_TOKEN=

# Storage and paging capabilities.
DATABASE_URL=
DATABASE_PUBLIC_URL=
DATABASE_RESTORE_URL=
REDIS_URL=
PGSSLROOTCERT=
WATCHDOG_PING_URL=
WATCHDOG_HEARTBEAT_URL=

# Generic runtime configuration.
ENV=
LOG_LEVEL=
PORT=

# WNBA provider identity and device configuration.
WNBA_DEVICE_UUID=
WNBA_DEVICE_NAME=

# WNBA runtime roles, model artifacts, and operator controls.
WNBA_CRON_ROLE=
WNBA_ORACLE_MODEL_ARTIFACT_SHA=
WNBA_ORACLE_MODEL_CHALLENGER_SHA=
JOB1_DRY_RUN=
JOB2_DRY_RUN=
PICKS_PAUSE_START=
PICKS_PAUSE_END=
POOL_EXCLUDE_STARTED_GAMES=
LIVE_OWNERSHIP_CAPTURE_ENABLED=
JOB1_MIN_POOL=
JOB1_MIN_TEAMS=
WNBA_DAYCLOSE_WALK_WINDOW=
WNBA_DAYCLOSE_REFRESH_GAMELOGS=

# Model and optimizer configuration. Defaults and the currently deployed values
# are defined in code and STATUS.md, not in this value-free declaration.
PAYOUT_REGIME=
OPTIMIZER_N_SAMPLES=
OPTIMIZER_TOP_N_FILTER=
OPTIMIZER_N_FIELD_LINEUPS=
OPTIMIZER_MAX_PER_TEAM=
OPTIMIZER_DYNAMIC_TEAM_CAP=
CONTRARIAN_STRENGTH=
CONTRARIAN_ENABLED=
CAVEAT_IS_SKIP=
NEVER_SKIP=
SAMPLING_SCORE_OFFSET=
STARTER_SIGNAL_ENABLED=
STARTER_SIGNAL_USE_EXPECTED=
# STARTER_UNKNOWN_FADE: multiplicative fade for players with no RotoWire
# starter or bench signal. Calibrated 2026-07-04: unknowns realize 0.685x
# mean expected-starter real_score and DNP at 5.8% vs 0.6%. Default: 0.75.
# Set to 1.0 to restore neutral (pre-2026-07-04) behavior.
STARTER_UNKNOWN_FADE=
STARTER_MINUTES_LIFT_ENABLED=
STARTER_MINUTES_NORM=
STARTER_MINUTES_LIFT_WEIGHT=
STARTER_MINUTES_LIFT_CAP=
PICKER_FLOOR_TILT_WEIGHT=
PICKER_FLOOR_TILT_MAX_BOOST=
MINUTES_MODEL_ENABLED=
GAME_SCRIPT_MINUTES_ENABLED=
LATE_REFREEZE_ENABLED=
LATE_REFREEZE_AFTER_UTC=
LATE_REFREEZE_DEADLINE_UTC=
REFREEZE_LOCK_BUFFER_MIN=
FREEZE_LEAD_MINUTES=
PROP_SIGNAL_SCALE=
LINEUP_ANCHOR_FLOOR=
AVAILABILITY_MODEL_ENABLED=
OPTIMIZER_BOOST_SUM_CAP=
OPTIMIZER_MAX_SINGLE_BOOST=
OPTIMIZER_GAME_STACK_BONUS=
OPTIMIZER_CONTEXTUAL_STACKING_ENABLED=
OPTIMIZER_CONTEXTUAL_STACK_EV_MARGIN=
FIELD_MEASURED_OWNERSHIP_ENABLED=
OPTIMIZER_LEVERAGE_WEIGHT=
OPTIMIZER_CEILING_WEIGHT=
OPTIMIZER_DUPLICATION_WEIGHT=
PICKER_BOOST_TAIL_LIFT=
BOOST_TAIL_LIFT_THRESHOLD=
BOOST_TAIL_LIFT_FACTOR=
PICKER_KNOB_CHALLENGER_JSON=
OPTIMIZER_CEILING_TILT_SLOTS=
OPTIMIZER_MIXTURE_VARIANCE_ENABLED=
FIELD_SAME_GAME_BOOST=
FIELD_SAME_TEAM_BOOST=
OPTIMIZER_DUPLICATION_AWARE_PAYOUT=
OPTIMIZER_COMMITTED_ORDER_OBJECTIVE=
OPTIMIZER_CEILING_SIGMA_BLOWOUT_BOOST=
OPTIMIZER_CEILING_SIGMA_LOW_HISTORY_BOOST=

# WNBA-owned HTTP and explicit Railway-operation configuration. These
# identifiers are not secrets, but they remain mutable and are recorded in
# STATUS.md. Scheduled read-only checks use public durable application evidence.
WNBA_API_BASE=
WNBA_RAILWAY_PROJECT_ID=
WNBA_RAILWAY_ENVIRONMENT_ID=
WNBA_RAILWAY_API_SERVICE_ID=
WNBA_RAILWAY_BACKFILL_SERVICE_ID=

# Backup output override for local or CI runs.
CORPUS_BACKUP_DIR=
