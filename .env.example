# Root-common automation capabilities. Values belong in
# .secrets/common.sops.env or the explicitly exported process environment.
# auth:optional
GITHUB_TOKEN=
RAILWAY_WORKSPACE_TOKEN=
RAILWAY_API_TOKEN=

# Local SOPS identity path. The private identity stays outside this repository
# with mode 0600. SOPS may also use its standard age identity location.
SOPS_AGE_KEY_FILE=
