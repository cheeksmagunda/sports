#!/usr/bin/env python3
"""Validate configured NFL auth capabilities without printing values.

Mirrors wnba-oracle/scripts/auth-check-live's shape and value-free contract.
Deliberately independent of nfl_oracle.ingest.realsports: this hook must stay
usable as a standalone diagnostic, not gated on the full ingest module's
heavier dependency chain (httpx, oracle-core retry policy).

No Real Sports GraphQL or Railway GraphQL probe here: NFL does not import
wnba-oracle's scripts/rwgql.py (portfolio boundary), and duplicating it would
mean two copies of tested Railway header/auth-header logic to keep in sync.
`railway whoami` covers Railway CLI liveness for this app; a GraphQL-level
probe stays wnba-owned until a second app needs it enough to justify sharing
it through oracle-core.

The Real Sports check here is structure-only by design: the operator-seeded
session is a durable, operator-held credential that is not assumed to expire
on a schedule. A live capture (Playwright reload against realsports.io) is a
much heavier, browser-dependent operation reserved for
wnba-oracle/scripts/probe_realsports.py-style manual deep checks, not this
routine, fast, always-available check.
"""

from __future__ import annotations

import base64
import gzip
import json
import os
import shutil
import subprocess
import sys

TIMEOUT_SECONDS = 10


def report(name: str, result: str) -> None:
    print(f"{name}: {result}")


def check_github() -> int:
    gh = shutil.which("gh")
    if gh is None:
        report("github", "not checked, gh is unavailable")
        return 0
    try:
        result = subprocess.run(
            [gh, "auth", "status", "--hostname", "github.com"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        report("github", "validation timed out")
        return 1
    if result.returncode == 0:
        report("github", "authenticated")
        return 0
    report("github", "authentication failed")
    return 1


def check_railway_cli() -> int:
    railway = shutil.which("railway")
    if railway is None:
        report("railway CLI", "not checked, CLI is unavailable")
        return 0
    try:
        result = subprocess.run(
            [railway, "whoami"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        report("railway CLI", "validation timed out")
        return 1
    if result.returncode == 0:
        report("railway CLI", "authenticated")
    else:
        report("railway CLI", "not authenticated")
    return int(result.returncode != 0)


def check_real_sports() -> int:
    encoded = os.environ.get("REALSPORTS_STORAGE_STATE_B64GZ", "").strip()
    if not encoded:
        report("Real Sports derived session", "not configured, browser recovery only")
        return 0
    try:
        raw = gzip.decompress(base64.b64decode(encoded, validate=True))
        payload = json.loads(raw)
    except (ValueError, OSError, json.JSONDecodeError):
        report("Real Sports derived session", "invalid payload")
        return 1
    if isinstance(payload, dict) and isinstance(payload.get("origins"), list):
        report("Real Sports derived session", "payload structure valid")
        return 0
    report("Real Sports derived session", "invalid storage-state structure")
    return 1


def main() -> int:
    errors = 0
    errors += check_github()
    errors += check_railway_cli()
    errors += check_real_sports()
    if errors:
        print(f"auth-check: live checks failed with {errors} issue(s)", file=sys.stderr)
        return 1
    print("auth-check: live checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
