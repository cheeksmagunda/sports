# Playwright storage_state.json (mode 0600). Never commit the real file.
# Prefer NFL_REALSPORTS_STORAGE_STATE or REALSPORTS_STORAGE_STATE_PATH for a
# private absolute path. REALSPORTS_STORAGE_STATE_B64GZ is for ephemeral
# bootstrap (base64 of gzip(storage_state.json)); materialize via
# scripts/seed_storage_state.py — never paste live values into git or docs.
NFL_REALSPORTS_STORAGE_STATE=
REALSPORTS_STORAGE_STATE_PATH=
NFL_REALSPORTS_TOKEN_CACHE=
REALSPORTS_TOKEN_CACHE_PATH=
NFL_ORACLE_SCRAPER_DIR=
REALSPORTS_STORAGE_STATE_B64GZ=

# Device identity used when harvesting headers (operator-local; not secrets).
# Code reads NFL_DEVICE_* only; the older NFL_REALSPORTS_DEVICE_* names were
# never read and are retired.
NFL_DEVICE_UUID=
NFL_DEVICE_NAME=

# Production Postgres for recommendations and the corpus backup. Railway sets
# NFL_DATABASE_URL on both services; NFL_BACKUP_DATABASE_URL is the Actions
# secret used by scripts/backup_corpus.py and falls back to NFL_DATABASE_URL.
NFL_DATABASE_URL=
NFL_BACKUP_DATABASE_URL=
# "1" enables the recommendations CLI/app on the worker.
NFL_RECOMMENDATIONS_ENABLED=
