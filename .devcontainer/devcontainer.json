{
	"name": "sports",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/sports",
	"remoteUser": "vscode",
	"updateRemoteUserUID": true,
	"features": {
		"ghcr.io/devcontainers/features/node:1.7.1": {
			"version": "22",
			"installYarnUsingApt": false
		},
		"ghcr.io/devcontainers/features/github-cli:1.1.1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.mypy-type-checker",
				"charliermarsh.ruff",
				"GitHub.copilot",
				"GitHub.copilot-chat"
			]
		}
	},
	"postCreateCommand": "make setup",
	"forwardPorts": [8000, 5173]
}
