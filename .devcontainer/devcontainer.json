{
	"name": "sports",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/sports",
	"remoteUser": "vscode",
	"updateRemoteUserUID": true,
	"containerEnv": {
		"DATABASE_URL": "postgresql://postgres:postgres@db:5432/sports_dev",
		"REDIS_URL": "redis://redis:6379",
		"PYTHONDONTWRITEBYTECODE": "1",
		"PYTHONUNBUFFERED": "1"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.mypy-type-checker",
				"charliermarsh.ruff",
				"GitHub.copilot",
				"GitHub.copilot-chat"
			]
		}
	},
	"postCreateCommand": "uv sync --frozen --all-packages --all-extras --no-editable && make codespaces-smoke",
	"forwardPorts": [5432, 6379]
}
