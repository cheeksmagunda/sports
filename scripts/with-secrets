#!/usr/bin/env python3
"""Optionally run one project command with local SOPS values in memory.

Normal commands use the process environment directly. This helper is only for
operators who choose to keep environment-backed values in ignored SOPS files.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys


USAGE = "Usage: scripts/with-secrets <project> -- <command> [args...]"
PROJECT_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
VARIABLE_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")


def fail(message: str, code: int) -> None:
    print(f"with-secrets: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_mode(path: Path, expected: int, label: str) -> None:
    actual = stat.S_IMODE(path.stat().st_mode)
    if actual != expected:
        fail(f"{label} must have mode {expected:04o}", 78)


def validate_secret_path(path: Path, expected_mode: int, label: str) -> None:
    if path.is_symlink():
        fail(f"{label} must not be a symbolic link", 78)
    if not path.is_file():
        fail(f"{label} is not a regular file", 78)
    require_mode(path, expected_mode, label)


def decrypt_env(path: Path, environment: dict[str, str]) -> dict[str, str]:
    if shutil.which("sops") is None:
        fail("sops is required to load encrypted local files", 69)
    result = subprocess.run(
        [
            "sops",
            "--decrypt",
            "--input-type",
            "dotenv",
            "--output-type",
            "json",
            str(path),
        ],
        check=False,
        capture_output=True,
        text=True,
        env=environment,
    )
    if result.returncode != 0:
        fail("sops could not decrypt a local secret file", 78)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        fail("sops returned an invalid environment payload", 78)
    if not isinstance(payload, dict):
        fail("the decrypted environment must be a flat object", 78)

    values: dict[str, str] = {}
    for name, value in payload.items():
        if not isinstance(name, str) or VARIABLE_NAME.fullmatch(name) is None:
            fail("the decrypted environment contains an invalid variable name", 78)
        if not isinstance(value, (str, int, float, bool)) and value is not None:
            fail("the decrypted environment contains a non-scalar value", 78)
        values[name] = "" if value is None else str(value)
    return values


def resolve_project(portfolio_root: Path, name: str) -> Path:
    if name in {".", ".."} or PROJECT_NAME.fullmatch(name) is None:
        fail("project must be a top-level directory name", 64)
    candidate = portfolio_root / name
    if candidate.is_symlink():
        fail("project directory must not be a symbolic link", 78)
    try:
        resolved = candidate.resolve(strict=True)
    except FileNotFoundError:
        fail("project directory not found", 66)
    if not resolved.is_dir() or resolved.parent != portfolio_root:
        fail("project must be a top-level directory name", 64)
    return resolved


def main() -> None:
    if len(sys.argv) < 4 or sys.argv[2] != "--" or not sys.argv[3]:
        print(USAGE, file=sys.stderr)
        raise SystemExit(64)

    portfolio_root = Path(__file__).resolve().parent.parent
    project = sys.argv[1]
    project_dir = resolve_project(portfolio_root, project)
    command = sys.argv[3:]

    # Resolve a relative command path (e.g. "scripts/auth-check") against the
    # operator's actual working directory NOW, before os.chdir(project_dir)
    # below moves the process elsewhere. execvpe resolves any path containing
    # a separator relative to the current directory at exec time rather than
    # searching $PATH, so leaving it relative here would silently resolve it
    # against project_dir instead of where the operator invoked this command.
    # A bare command name (no separator) is untouched: it is looked up via
    # $PATH, which chdir does not affect.
    if os.sep in command[0] or (os.altsep and os.altsep in command[0]):
        command = [str((Path.cwd() / command[0]).resolve()), *command[1:]]

    sources = (
        (
            portfolio_root / ".secrets",
            portfolio_root / ".secrets" / "common.sops.env",
            "root secret directory",
        ),
        (
            project_dir / ".secrets",
            project_dir / ".secrets" / "local.sops.env",
            "project secret directory",
        ),
    )

    encrypted_present = any(
        secret_file.exists() or secret_file.is_symlink()
        for _, secret_file, _ in sources
    )
    key_path: Path | None = None
    if encrypted_present:
        key_setting = os.environ.get("SOPS_AGE_KEY_FILE", "").strip()
        if not key_setting:
            default_key = Path.home() / ".config" / "sops" / "age" / "keys.txt"
            if default_key.is_file():
                key_setting = str(default_key)
        if key_setting:
            try:
                key_path = Path(key_setting).expanduser().resolve(strict=True)
            except FileNotFoundError:
                fail("configured age key file was not found", 66)
            try:
                key_path.relative_to(portfolio_root)
            except ValueError:
                pass
            else:
                fail("the age private key must be outside the repository", 78)
            validate_secret_path(key_path, 0o600, "the age private key")

    sops_environment = os.environ.copy()
    if key_path is not None:
        sops_environment["SOPS_AGE_KEY_FILE"] = str(key_path)

    loaded: list[dict[str, str]] = []
    for directory, secret_file, label in sources:
        if directory.exists() or directory.is_symlink():
            if directory.is_symlink() or not directory.is_dir():
                fail(f"{label} is not a regular directory", 78)
            require_mode(directory, 0o700, label)
        if secret_file.exists() or secret_file.is_symlink():
            validate_secret_path(secret_file, 0o600, "the encrypted local secret file")
            loaded.append(decrypt_env(secret_file, sops_environment))
        else:
            loaded.append({})

    root_values, app_values = loaded
    merged = dict(root_values)
    merged.update(app_values)
    merged.update(os.environ)
    if key_path is not None:
        merged.setdefault("SOPS_AGE_KEY_FILE", str(key_path))
    merged["SPORTS_PORTFOLIO_ROOT"] = str(portfolio_root)
    merged["SPORTS_PROJECT_ROOT"] = str(project_dir)
    merged["SPORTS_SECRETS_ACTIVE"] = project

    os.chdir(project_dir)
    try:
        os.execvpe(command[0], command, merged)
    except FileNotFoundError:
        fail("command not found", 69)
    except PermissionError:
        fail("command is not executable", 77)


if __name__ == "__main__":
    main()
