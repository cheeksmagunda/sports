#!/bin/sh
set -eu

# Prove the write path before material work.
# Reports the acting environment, confirms this session can push to the remote,
# and fails when unpushed history has grown past the ceiling.
# Never prints credential values.

# One gh identity for the Mac-side codespace check (issue #235 gap: a local
# agent CLI (Claude Code, Codex CLI, Copilot CLI) can inject its own scoped
# GH_TOKEN/GITHUB_TOKEN for its own API calls; gh prefers that env token over
# the native keyring `gh auth login`, so a narrower/expired agent token
# silently 403s `gh codespace list` even though the real, codespace-scoped
# login underneath is fine. This script must always resolve to the native
# login, exactly like the Codespace's own interactive-shell rule.
unset GITHUB_TOKEN GH_TOKEN

remote="${1:-origin}"
ceiling="${SPORTS_UNPUSHED_CEILING:-5}"
branch="$(git rev-parse --abbrev-ref HEAD)"

echo "Acting environment"
echo "  host: $(hostname)"
echo "  checkout: $(pwd)"
if [ "${CODESPACES:-false}" = "true" ]; then
    echo "  codespace: ${CODESPACE_NAME:-unnamed}"
else
    echo "  codespace: no (not the canonical environment)"
fi
echo "  remote: $(git remote get-url "$remote")"
echo "  branch: ${branch}"

echo "Checking write path"
if [ "${CODESPACES:-false}" = "true" ] && git push --dry-run "$remote" "HEAD:refs/heads/preflight/write-path-check" >/dev/null 2>&1; then
    echo "  push: allowed"
elif [ "${CODESPACES:-false}" != "true" ] && command -v gh >/dev/null 2>&1 && gh codespace list --json name,repository,state --jq '.[] | select(.repository == "cheeksmagunda/sports") | select(.state != "Deleted") | .name' | grep -q .; then
    echo "  local push: not used"
    echo "  Codespace push route: available"
else
    echo "  Codespace push route unavailable to ${remote}" >&2
    echo "  Set SPORTS_CODESPACE_NAME or use an authenticated Codespace." >&2
    exit 1
fi

echo "Checking unpushed backlog"
if git rev-parse --verify --quiet "${remote}/${branch}" >/dev/null 2>&1; then
    base="${remote}/${branch}"
else
    base="${remote}/main"
fi
ahead="$(git rev-list --count "${base}..HEAD")"
echo "  unpushed commits vs ${base}: ${ahead} (ceiling ${ceiling})"
if [ "${ahead}" -gt "${ceiling}" ]; then
    echo "  Push the branch or open a draft pull request before continuing." >&2
    exit 1
fi

echo "Write path check passed"
