#!/usr/bin/env python3
"""Prepare a Codespace shell for Railway CLI, then exec a command (or print exports).

Why this exists
---------------
Headless ``gh codespace ssh`` often has no ``RAILWAY_*`` in the environment even
with a login shell. Codespaces still writes user secrets to
``/workspaces/.codespaces/shared/.env-secrets``. Loading that file with bash
``.`` can mangle values; this helper loads them in Python.

Canonical auth is a synced Mac ``~/.railway`` CLI OAuth session (accessToken /
refreshToken). The Codespaces secret ``RAILWAY_API_TOKEN`` may be present but
Unauthorized; prefer the CLI session first, and only try the API token if the
session is missing or whoami fails. If both ``RAILWAY_API_TOKEN`` (account) and
``RAILWAY_TOKEN`` (project/CI) are set, the Railway CLI returns Unauthorized.
This helper always drops ``RAILWAY_TOKEN`` when an account token or CLI session
will be used.

Usage
-----
  scripts/codespace-railway-env -- railway whoami
  scripts/codespace-railway-env -- railway ssh --service nfl-oracle-worker -- bash -lc '...'
  eval "$(scripts/codespace-railway-env --print-exports)"   # then run railway yourself

Exit codes: 0 ok, 2 usage, 3 secrets missing, 4 whoami failed (restore a CLI
session via scripts/sync-railway-session-to-codespace, or refresh Codespaces
``RAILWAY_API_TOKEN`` only if no session works).
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

USAGE = (
    "Usage: scripts/codespace-railway-env [--print-exports | --] "
    "[railway-args-or-command...]"
)
SECRETS_CANDIDATES = (
    Path("/workspaces/.codespaces/shared/.env-secrets"),
    Path.home() / ".codespaces" / "shared" / ".env-secrets",
)
RAILWAY_CONFIG = Path.home() / ".railway" / "config.json"
UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
)


def fail(msg: str, code: int) -> None:
    print(f"codespace-railway-env: {msg}", file=sys.stderr)
    raise SystemExit(code)


def parse_dotenv(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.strip()
        if (val.startswith('"') and val.endswith('"')) or (
            val.startswith("'") and val.endswith("'")
        ):
            val = val[1:-1]
        out[key] = val
    return out


def load_api_token() -> str | None:
    env_tok = os.environ.get("RAILWAY_API_TOKEN", "").strip()
    if env_tok:
        return env_tok
    for path in SECRETS_CANDIDATES:
        if not path.is_file():
            continue
        data = parse_dotenv(path)
        raw = (data.get("RAILWAY_API_TOKEN") or "").strip()
        if not raw:
            continue
        # Prefer a UUID-shaped prefix when the stored value has trailing junk
        # (observed: file length 48, working identity length 36).
        m = UUID_RE.match(raw)
        if m:
            return m.group(0)
        if "#" in raw:
            return raw.split("#", 1)[0].strip()
        return raw
    return None


def cli_session_present(config_path: Path | None = None) -> bool:
    """True when ~/.railway/config.json has usable OAuth access/refresh tokens."""
    path = config_path if config_path is not None else RAILWAY_CONFIG
    if not path.is_file():
        return False
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    user = data.get("user") if isinstance(data, dict) else None
    if not isinstance(user, dict):
        return False
    access = (user.get("accessToken") or user.get("token") or "").strip()
    refresh = (user.get("refreshToken") or "").strip()
    return bool(access or refresh)


def whoami(env: dict[str, str]) -> tuple[bool, str]:
    railway = shutil.which("railway")
    if railway is None:
        return False, "railway CLI not on PATH"
    result = subprocess.run(
        [railway, "whoami"],
        check=False,
        capture_output=True,
        text=True,
        env=env,
    )
    text = (result.stdout or "") + (result.stderr or "")
    return result.returncode == 0, text.strip()


def prefer_auth_order(
    *,
    session_ok: bool,
    api_token_present: bool,
) -> list[str]:
    """Return preference order labels: 'cli-session' then optionally 'api-token'."""
    order: list[str] = []
    if session_ok:
        order.append("cli-session")
    if api_token_present:
        order.append("api-token")
    return order


def build_env(
    *,
    whoami_fn=whoami,
    session_present_fn=cli_session_present,
    load_api_token_fn=load_api_token,
) -> dict[str, str]:
    env = os.environ.copy()
    # Never both token kinds.
    env.pop("RAILWAY_TOKEN", None)

    session_ok = session_present_fn()
    api = load_api_token_fn()
    order = prefer_auth_order(
        session_ok=session_ok, api_token_present=bool(api)
    )

    for path_name in order:
        trial = env.copy()
        trial.pop("RAILWAY_TOKEN", None)
        if path_name == "cli-session":
            trial.pop("RAILWAY_API_TOKEN", None)
            ok, detail = whoami_fn(trial)
            if ok:
                print(
                    "codespace-railway-env: auth ok via CLI session "
                    f"({detail.splitlines()[0] if detail else 'whoami'})",
                    file=sys.stderr,
                )
                # Keep API token out of the child so session stays authoritative.
                env.pop("RAILWAY_API_TOKEN", None)
                return env
            print(
                "codespace-railway-env: CLI session present but whoami failed; "
                "trying RAILWAY_API_TOKEN if available",
                file=sys.stderr,
            )
            continue

        if path_name == "api-token" and api:
            trial["RAILWAY_API_TOKEN"] = api
            ok, detail = whoami_fn(trial)
            if ok:
                env["RAILWAY_API_TOKEN"] = api
                print(
                    "codespace-railway-env: auth ok via RAILWAY_API_TOKEN "
                    f"({detail.splitlines()[0] if detail else 'whoami'})",
                    file=sys.stderr,
                )
                return env
            print(
                "codespace-railway-env: RAILWAY_API_TOKEN present but whoami failed",
                file=sys.stderr,
            )

    # Final attempt: bare env (no API token) in case session files exist but
    # detection missed them, or railway is somehow already authenticated.
    bare = env.copy()
    bare.pop("RAILWAY_API_TOKEN", None)
    bare.pop("RAILWAY_TOKEN", None)
    ok, detail = whoami_fn(bare)
    if ok:
        env.pop("RAILWAY_API_TOKEN", None)
        print(
            "codespace-railway-env: auth ok via CLI session "
            f"({detail.splitlines()[0] if detail else 'whoami'})",
            file=sys.stderr,
        )
        return env

    fail(
        "railway whoami failed. Restore a logged-in ~/.railway session on this "
        "Codespace (from Mac: scripts/sync-railway-session-to-codespace), or "
        "refresh the Codespaces secret RAILWAY_API_TOKEN only if no session "
        "works. Detail: " + (detail or "no output"),
        4,
    )
    raise AssertionError("unreachable")


def main() -> None:
    args = sys.argv[1:]
    if not args:
        print(USAGE, file=sys.stderr)
        raise SystemExit(2)

    print_exports = False
    if args[0] == "--print-exports":
        print_exports = True
        args = args[1:]
    elif args[0] == "--":
        args = args[1:]
    else:
        print(USAGE, file=sys.stderr)
        raise SystemExit(2)

    env = build_env()

    if print_exports:
        # Safe for eval: only export/unset lines, never echo secret values
        # except the export itself when the API-token path won.
        if "RAILWAY_API_TOKEN" in env:
            import shlex

            print(f"export RAILWAY_API_TOKEN={shlex.quote(env['RAILWAY_API_TOKEN'])}")
        else:
            print("unset RAILWAY_API_TOKEN")
        print("unset RAILWAY_TOKEN")
        return

    if not args:
        print(USAGE, file=sys.stderr)
        raise SystemExit(2)

    os.execvpe(args[0], args, env)


if __name__ == "__main__":
    main()
