#!/usr/bin/env python3
"""Report portable authentication capabilities without printing values.

This command inspects the current process environment and native CLI sessions.
It does not decrypt optional local secret files. Use ``with-secrets`` explicitly
when a live check should receive values stored with SOPS.
"""

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import stat
import sys


USAGE = "Usage: scripts/auth-check <project> --offline|--live"
PROJECT_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
DECLARATION = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)\Z")


def file_mode(path: Path) -> int:
    return stat.S_IMODE(path.stat().st_mode)


def status(label: str, value: str) -> None:
    print(f"{label}: {value}")


def parse_example(path: Path) -> tuple[list[tuple[str, bool]], list[str]]:
    declarations: list[tuple[str, bool]] = []
    errors: list[str] = []
    required = False
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.rstrip("\r")
        if line == "# auth:required":
            required = True
            continue
        if line == "# auth:optional":
            required = False
            continue
        if not line or line.startswith("#"):
            continue
        match = DECLARATION.fullmatch(line)
        if match is None:
            errors.append(f"{path.name} line {number}: invalid declaration")
            continue
        name, example_value = match.groups()
        declarations.append((name, required))
        if example_value:
            errors.append(f"{name}: tracked example value must be empty")
    return declarations, errors


def resolve_project(portfolio_root: Path, name: str) -> Path:
    if name in {".", ".."} or PROJECT_NAME.fullmatch(name) is None:
        print("auth-check: project must be a top-level directory name", file=sys.stderr)
        raise SystemExit(64)
    candidate = portfolio_root / name
    if candidate.is_symlink():
        print(
            "auth-check: project directory must not be a symbolic link", file=sys.stderr
        )
        raise SystemExit(78)
    try:
        project_dir = candidate.resolve(strict=True)
    except FileNotFoundError:
        print("auth-check: project directory not found", file=sys.stderr)
        raise SystemExit(66)
    if not project_dir.is_dir() or project_dir.parent != portfolio_root:
        print("auth-check: project must be a top-level directory name", file=sys.stderr)
        raise SystemExit(64)
    return project_dir


def inspect_secret_location(
    directory: Path, secret_file: Path, label: str
) -> tuple[bool, list[str]]:
    issues: list[str] = []
    if directory.exists() or directory.is_symlink():
        if directory.is_symlink() or not directory.is_dir():
            issues.append(f"{label} directory is invalid")
        elif file_mode(directory) != 0o700:
            issues.append(f"{label} directory must have mode 0700")

    if secret_file.exists() or secret_file.is_symlink():
        if secret_file.is_symlink() or not secret_file.is_file():
            issues.append(f"{label} encrypted file is invalid")
        elif file_mode(secret_file) != 0o600:
            issues.append(f"{label} encrypted file must have mode 0600")
    return secret_file.is_file(), issues


def check_age_identity(portfolio_root: Path) -> list[str]:
    configured = os.environ.get("SOPS_AGE_KEY_FILE", "").strip()
    if configured:
        try:
            path = Path(configured).expanduser().resolve(strict=True)
        except FileNotFoundError:
            return ["configured age identity is missing"]
        try:
            path.relative_to(portfolio_root)
        except ValueError:
            pass
        else:
            return ["age identity must stay outside the repository"]
        if path.is_file() and file_mode(path) == 0o600:
            return []
        return ["configured age identity must be a mode 0600 file"]

    default_path = Path.home() / ".config" / "sops" / "age" / "keys.txt"
    if default_path.is_file():
        if file_mode(default_path) == 0o600:
            return []
        return ["standard age identity must have mode 0600"]
    return []


def check_optional_encrypted_helper(
    portfolio_root: Path,
    root_dir: Path,
    root_file: Path,
    app_dir: Path,
    app_file: Path,
) -> int:
    root_configured, root_issues = inspect_secret_location(
        root_dir, root_file, "root"
    )
    app_configured, app_issues = inspect_secret_location(
        app_dir, app_file, "project"
    )
    configured = root_configured or app_configured
    issues = root_issues + app_issues
    if configured:
        for tool in ("sops", "age"):
            if shutil.which(tool) is None:
                issues.append(f"{tool} is unavailable")
        issues.extend(check_age_identity(portfolio_root))

    if issues:
        status("optional encrypted helper", "; ".join(issues))
        return len(issues)
    status("optional encrypted helper", "ready" if configured else "not configured")
    return 0


def environment_capabilities() -> list[str]:
    groups = (
        ("database", ("DATABASE_URL", "DATABASE_PUBLIC_URL", "DATABASE_RESTORE_URL")),
        ("redis", ("REDIS_URL",)),
        ("Real Sports session", ("REALSPORTS_STORAGE_STATE_B64GZ",)),
        ("odds provider", ("ODDS_API_KEY",)),
        ("Railway HTTP", ("RAILWAY_WORKSPACE_TOKEN",)),
        ("watchdog", ("WATCHDOG_PING_URL", "WATCHDOG_HEARTBEAT_URL")),
    )
    return [
        label
        for label, names in groups
        if any(os.environ.get(name, "").strip() for name in names)
    ]


def main() -> None:
    if len(sys.argv) != 3 or sys.argv[2] not in {"--offline", "--live"}:
        print(USAGE, file=sys.stderr)
        raise SystemExit(64)

    project = sys.argv[1]
    mode = sys.argv[2]
    script_dir = Path(__file__).resolve().parent
    portfolio_root = script_dir.parent
    project_dir = resolve_project(portfolio_root, project)

    root_example = portfolio_root / ".env.example"
    app_example = project_dir / ".env.example"
    if not root_example.is_file() or not app_example.is_file():
        print(
            "auth-check: tracked environment declarations are missing", file=sys.stderr
        )
        raise SystemExit(66)

    root_dir = portfolio_root / ".secrets"
    root_file = root_dir / "common.sops.env"
    app_dir = project_dir / ".secrets"
    app_file = app_dir / "local.sops.env"
    errors = 0
    errors += check_optional_encrypted_helper(
        portfolio_root, root_dir, root_file, app_dir, app_file
    )
    status("GitHub CLI", "available" if shutil.which("gh") else "unavailable")
    status("Railway CLI", "available" if shutil.which("railway") else "unavailable")
    status("HTTPS client", "available" if shutil.which("curl") else "unavailable")

    root_declarations, root_errors = parse_example(root_example)
    app_declarations, app_errors = parse_example(app_example)
    for message in (*root_errors, *app_errors):
        print(message)
        errors += 1

    seen: set[str] = set()
    declarations = root_declarations + app_declarations
    if not declarations:
        print("auth-check: no environment variables declared", file=sys.stderr)
        errors += 1
    for name, required in declarations:
        if name in seen:
            status(name, "declared more than once")
            errors += 1
            continue
        seen.add(name)
        if required and not os.environ.get(name, "").strip():
            status("required environment", f"{name} is missing")
            errors += 1

    capabilities = environment_capabilities()
    status(
        "process environment",
        ", ".join(capabilities) if capabilities else "no auth capabilities configured",
    )

    if errors:
        print(f"auth-check: failed with {errors} issue(s)", file=sys.stderr)
        raise SystemExit(1)

    if mode == "--offline":
        print("auth-check: offline checks passed")
        return

    hook = project_dir / "scripts" / "auth-check-live"
    if not hook.is_file() or not os.access(hook, os.X_OK):
        print("auth-check: executable live hook is unavailable", file=sys.stderr)
        raise SystemExit(69)
    sys.stdout.flush()
    os.chdir(project_dir)
    os.execv(str(hook), [str(hook)])


if __name__ == "__main__":
    main()
