# Root-context builds are deny-first. Allow paths only when a Dockerfile
# (WNBA backend or nfl-oracle local research) copies them into an image.
**

!pyproject.toml
!uv.lock

!packages/
!packages/oracle-core/
packages/oracle-core/**
!packages/oracle-core/pyproject.toml
!packages/oracle-core/README.md
!packages/oracle-core/src/
!packages/oracle-core/src/**

!wnba-oracle/
wnba-oracle/**
!wnba-oracle/Dockerfile
!wnba-oracle/pyproject.toml
!wnba-oracle/README.md
!wnba-oracle/alembic.ini
!wnba-oracle/src/
!wnba-oracle/src/**
!wnba-oracle/migrations/
!wnba-oracle/migrations/**
!wnba-oracle/scripts/
!wnba-oracle/scripts/seed_storage_state.py
!wnba-oracle/scripts/runtime_role_probe.py
!wnba-oracle/data/
!wnba-oracle/data/contest_payouts/
!wnba-oracle/data/contest_payouts/.gitkeep
!wnba-oracle/data/historical/
!wnba-oracle/data/historical/.gitkeep
!wnba-oracle/data/processed/
!wnba-oracle/data/processed/.gitkeep
!wnba-oracle/data/raw/
!wnba-oracle/data/raw/.gitkeep
!wnba-oracle/models/
!wnba-oracle/models/.gitkeep
!wnba-oracle/models/picker_e2ced9ec_1780873338.pkl
!wnba-oracle/models/picker_e2ced9ec_1780873338.sha256

# nfl-oracle local research image (observation-only; not Railway).
!nfl-oracle/
nfl-oracle/**
!nfl-oracle/Dockerfile
!nfl-oracle/docker-compose.yml
!nfl-oracle/pyproject.toml
!nfl-oracle/README.md
!nfl-oracle/src/
!nfl-oracle/src/**
!nfl-oracle/data/
!nfl-oracle/data/catalog/
!nfl-oracle/data/catalog/**
!nfl-oracle/data/schedule/
!nfl-oracle/data/schedule/**
!nfl-oracle/data/raw/
!nfl-oracle/data/raw/.gitkeep

# The deny-first rule above also excludes these local and sensitive paths.
# They are listed to make the build boundary auditable.
.git/
**/.env
**/.env.*
**/.secrets/
**/*.pem
**/*.key
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
wnba-oracle/frontend/
wnba-oracle/tests/
wnba-oracle/data/backups/
wnba-oracle/data/snapshot/

nfl-oracle/tests/
nfl-oracle/scraper/
nfl-oracle/.secrets/
nfl-oracle/data/artifacts/
nfl-oracle/data/cache/
nfl-oracle/data/raw/corpus_g/
